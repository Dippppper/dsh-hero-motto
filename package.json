{
  "name": "dsh-hero-motto",
  "version": "2.0.3",
  "description": "Rotating DeepSeek-style mottos beside the new-session whale, with animations, fonts, alignment, keyword emphasis, and an accent colour.",
  "type": "module",
  "keywords": ["dsh-plugin", "dsh-bundle", "deepseek-harness"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.png", "docs/*.png", "README.md", "README.zh.md", "LICENSE"],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
