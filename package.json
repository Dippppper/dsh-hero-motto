{
  "name": "dsh-hero-motto",
  "version": "2.2.2",
  "description": "Rotating DeepSeek-style mottos beside the new-session whale, with animations, fonts, alignment, keyword emphasis, and an accent colour. Ships a second component: the composer border marquee.",
  "type": "module",
  "keywords": ["dsh-plugin", "dsh-bundle", "deepseek-harness"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dippppper/dsh-hero-motto.git"
  },
  "homepage": "https://github.com/Dippppper/dsh-hero-motto#readme",
  "bugs": {
    "url": "https://github.com/Dippppper/dsh-hero-motto/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./motto": "./motto/index.js",
    "./motto/icon": "./icon.png",
    "./motto/locale/*.json": "./locale/motto/*.json",
    "./marquee": "./marquee/index.js",
    "./marquee/icon": "./icon.png",
    "./marquee/locale/*.json": "./locale/marquee/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "client.js", "motto/*.js", "marquee/*.js", "cordis.patch.yml", "locale/*.json", "locale/motto/*.json", "locale/marquee/*.json", "icon.png", "docs/*.png", "docs/*.webp", "README.md", "README.zh.md", "LICENSE"],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
